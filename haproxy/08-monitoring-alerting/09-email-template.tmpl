{{/*
  HAProxy Alert Email Template — enhanced HTML
  Not wired into alertmanager.yml. To use, see the wiring note at the
  bottom of this file — apply it yourself when ready.
*/}}
{{ define "haproxy.email.subject" }}[{{ .Status | toUpper }}{{ if eq .Status "firing" }}:{{ len .Alerts.Firing }}{{ end }}] {{ .CommonLabels.alertname }}{{ if .CommonLabels.proxy }} — {{ .CommonLabels.proxy }}{{ end }}{{ end }}

{{ define "haproxy.email.html" }}
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<style>
  body {
    margin: 0;
    padding: 0;
    background-color: #f4f5f7;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: #172b4d;
  }
  .wrapper {
    max-width: 640px;
    margin: 0 auto;
    padding: 24px 16px;
  }
  .header-band {
    border-radius: 8px 8px 0 0;
    padding: 20px 24px;
    {{ if eq .Status "firing" }}
    background: linear-gradient(135deg, #c0392b, #8c1a1a);
    {{ else }}
    background: linear-gradient(135deg, #1e8e3e, #146c2e);
    {{ end }}
  }
  .header-band .status-pill {
    display: inline-block;
    background: rgba(255,255,255,0.2);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 12px;
    margin-bottom: 8px;
  }
  .header-band h1 {
    margin: 0;
    color: #ffffff;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.3;
  }
  .header-band p {
    margin: 6px 0 0;
    color: rgba(255,255,255,0.85);
    font-size: 13px;
  }
  .body-card {
    background: #ffffff;
    border: 1px solid #dfe1e6;
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 20px 24px;
  }
  .meta-row {
    display: table;
    width: 100%;
    padding: 10px 0;
    border-bottom: 1px solid #f0f1f3;
    font-size: 13px;
  }
  .meta-row:last-child { border-bottom: none; }
  .meta-label {
    display: table-cell;
    width: 130px;
    color: #6b778c;
    font-weight: 600;
    vertical-align: top;
  }
  .meta-value {
    display: table-cell;
    color: #172b4d;
    vertical-align: top;
  }
  .alert-item {
    margin-top: 16px;
    padding: 14px 16px;
    border-left: 4px solid {{ if eq .Status "firing" }}#c0392b{{ else }}#1e8e3e{{ end }};
    background: #fafbfc;
    border-radius: 0 6px 6px 0;
  }
  .alert-item .alert-title {
    font-weight: 700;
    font-size: 14px;
    margin-bottom: 4px;
  }
  .alert-item .alert-desc {
    font-size: 13px;
    color: #42526e;
    line-height: 1.5;
  }
  .footer {
    text-align: center;
    padding: 16px 8px;
    font-size: 11px;
    color: #97a0af;
  }
  .btn {
    display: inline-block;
    margin-top: 16px;
    padding: 10px 20px;
    background: #172b4d;
    color: #ffffff !important;
    text-decoration: none;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
  }
</style>
</head>
<body>
  <div class="wrapper">

    <div class="header-band">
      <span class="status-pill">{{ .Status }}{{ if .CommonLabels.severity }} · {{ .CommonLabels.severity }}{{ end }}</span>
      <h1>{{ .CommonLabels.alertname }}</h1>
      {{ if .CommonAnnotations.summary }}<p>{{ .CommonAnnotations.summary }}</p>{{ end }}
    </div>

    <div class="body-card">

      <div class="meta-row">
        <div class="meta-label">Status</div>
        <div class="meta-value">{{ .Status | toUpper }}</div>
      </div>
      {{ if .CommonLabels.proxy }}
      <div class="meta-row">
        <div class="meta-label">Backend</div>
        <div class="meta-value">{{ .CommonLabels.proxy }}</div>
      </div>
      {{ end }}
      <div class="meta-row">
        <div class="meta-label">Alert count</div>
        <div class="meta-value">{{ len .Alerts }} ({{ len .Alerts.Firing }} firing, {{ len .Alerts.Resolved }} resolved)</div>
      </div>
      <div class="meta-row">
        <div class="meta-label">Started</div>
        <div class="meta-value">{{ (index .Alerts 0).StartsAt.Format "2006-01-02 15:04:05 MST" }}</div>
      </div>

      {{ range .Alerts }}
      <div class="alert-item">
        <div class="alert-title">
          {{ if .Labels.server }}{{ .Labels.server }}{{ else }}{{ .Labels.proxy }}{{ end }}
        </div>
        <div class="alert-desc">{{ .Annotations.description }}</div>
      </div>
      {{ end }}

      <a href="{{ .ExternalURL }}" class="btn">View in Alertmanager</a>

    </div>

    <div class="footer">
      HAProxy Monitoring &middot; loadbalancer-01 &middot; automated alert, do not reply
    </div>

  </div>
</body>
</html>
{{ end }}
